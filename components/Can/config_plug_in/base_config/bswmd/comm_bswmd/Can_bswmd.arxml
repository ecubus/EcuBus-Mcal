                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>CanGeneral</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">This container contains the parameters related each CAN Driver Unit.</L-2>
                  </DESC>

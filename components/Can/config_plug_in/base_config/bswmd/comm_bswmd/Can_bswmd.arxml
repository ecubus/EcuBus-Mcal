                            <L-2 L="EN">Specifies if the HardwareObject is used as Transmit or as Receive object</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00327</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
